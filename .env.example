# Copy to .env and fill in. Never commit .env.
# Model IDs below were verified against each provider's /v1/models endpoint on: 2026-10-26 (python -m src.verify_setup)

# --- LLM provider 1: OpenAI (generation + embeddings) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_STRONG_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM provider 2: NVIDIA NIM (build.nvidia.com) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_STRONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_RPM_LIMIT=40

# --- Vector store: Pinecone (Starter plan = AWS us-east-1 only) ---
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=agent-engineering-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=corpus

# --- Real-time knowledge: Tavily Remote MCP (key is sent as a URL query parameter) ---
TAVILY_API_KEY=tvly-...

# --- RAG / orchestration ---
RETRIEVAL_K=8
CONTEXT_K=5
MAX_HOPS=6
ROUTING_POLICY=balanced

# --- Conversation state: memory | sqlite (local dev) | firestore (Cloud Run) ---
STATE_BACKEND=sqlite
# Firestore Native mode, "(default)" database (used when STATE_BACKEND=firestore)
FIRESTORE_PROJECT_ID=your-project-id
FIRESTORE_COLLECTION=langgraph_checkpoints

# --- Cloud Run deployment ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-east4
CLOUD_RUN_SERVICE=multi-agent-rag
